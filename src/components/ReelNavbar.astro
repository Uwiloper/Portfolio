---
import navItems from '../data/navigation.json';
---

<nav id="reel-nav-container" class="fixed inset-0 pointer-events-none z-50 overflow-hidden select-none">
  
  <!-- ZONA DE DESLIZAMIENTO (Móvil): toda la franja inferior responde al swipe, no solo el carrete -->
  <div id="reel-swipe-zone" class="lg:hidden absolute bottom-0 inset-x-0 h-[190px] pointer-events-auto touch-none z-[5]" aria-hidden="true"></div>

  <!-- FLECHAS (Móvil): indican que el menú se mueve a los lados y sirven como botones -->
  <button id="reel-prev" type="button" aria-label="Sección anterior" class="reel-arrow reel-arrow-left lg:hidden absolute left-3 bottom-[44px] z-30 w-11 h-11 flex items-center justify-center pointer-events-auto text-pink-500 transition-opacity duration-300">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" class="w-6 h-6 drop-shadow-[0_0_8px_rgba(236,72,153,0.9)]"><path d="M15 5l-7 7 7 7"/></svg>
  </button>
  <button id="reel-next" type="button" aria-label="Sección siguiente" class="reel-arrow reel-arrow-right lg:hidden absolute right-3 bottom-[44px] z-30 w-11 h-11 flex items-center justify-center pointer-events-auto text-pink-500 transition-opacity duration-300">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" class="w-6 h-6 drop-shadow-[0_0_8px_rgba(236,72,153,0.9)]"><path d="M9 5l7 7-7 7"/></svg>
  </button>

  <!-- INDICADOR DE INTERACCIÓN (Rosa Neón, encima de la rueda) -->
  <div id="interaction-hint" class="absolute z-30 pointer-events-none transition-opacity duration-1000 opacity-100 bottom-[22px] left-1/2 -translate-x-1/2 lg:bottom-auto lg:top-1/2 lg:left-auto lg:right-[50px] lg:-translate-y-1/2 flex items-center justify-center">

    <!-- Móvil: Manito Deslizando + texto -->
    <div class="flex lg:hidden flex-col items-center gap-1">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="animate-swipe-hand w-8 h-8 text-[rgba(236,72,153,0.8)] drop-shadow-[0_0_8px_rgba(236,72,153,0.5)]">
        <path d="M10 13V5a2 2 0 1 1 4 0v9"/><path d="M14 11V9a2 2 0 1 1 4 0v4"/><path d="M18 13v-1a2 2 0 1 1 4 0v7a8 8 0 0 1-16 0v-5.5a2.5 2.5 0 0 1 5 0V15"/>
      </svg>
      <span class="font-mono text-[10px] tracking-[0.3em] uppercase text-pink-300 drop-shadow-[0_0_6px_rgba(236,72,153,0.8)] whitespace-nowrap">Desliza</span>
    </div>

    <!-- Web: Mouse Scroll -->
    <div class="hidden lg:flex">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-10 text-[rgba(236,72,153,0.8)] drop-shadow-[0_0_8px_rgba(236,72,153,0.5)]">
        <rect x="5" y="2" width="14" height="20" rx="7" ry="7"></rect>
        <line x1="12" y1="6" x2="12" y2="10" class="animate-scroll-wheel"></line>
      </svg>
    </div>

  </div>

  <!-- Posicion del texto -->  
  <div class="absolute bottom-[140px] left-1/2 -translate-x-1/2 lg:bottom-auto lg:left-auto lg:top-1/2 lg:right-[220px] xl:right-[150px] lg:-translate-y-1/2 lg:translate-x-0 w-full lg:w-[400px] h-[50px] pointer-events-none z-10 flex justify-center lg:justify-end items-center">
    
    {navItems.map((item, index) => (
      <button 
        class="nav-label absolute flex flex-col lg:flex-row items-center justify-center lg:justify-end gap-2 lg:gap-3 transition-all duration-500 pointer-events-auto cursor-pointer w-max lg:w-full origin-bottom lg:origin-right"
        data-index={index}
        data-target={item.id}
      >
        <span class="font-display text-lg md:text-xl lg:text-3xl uppercase tracking-widest transition-all duration-500 whitespace-nowrap text-white/40">
          {item.label}
        </span>
        
        <div class="pointer-indicator opacity-0 transition-opacity duration-300 absolute lg:relative -bottom-6 lg:bottom-auto">
          <span class="text-pink-500 text-[10px] md:text-xs font-mono lg:rotate-0 rotate-90 block drop-shadow-[0_0_8px_rgba(236,72,153,1)]">▶</span>
        </div>
      </button>
    ))}

  </div>

  <!-- Rueda Z-20 -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-[45%] lg:bottom-auto lg:left-auto lg:top-1/2 lg:right-0 lg:-translate-y-1/2 lg:translate-x-[50%] w-[220px] h-[220px] lg:w-[380px] lg:h-[380px] xl:w-[420px] xl:h-[420px] flex items-center justify-center pointer-events-auto z-20">
    
    <div 
      id="reel-rotator" class="w-20px h-20px rounded-full cursor-grab active:cursor-grabbing will-change-transform touch-none"
    >
      <img 
        src="/icons/cinta_rollo.svg" 
        alt="Carrete VHS" 
        class="w-full h-full object-contain drop-shadow-[0_0_30px_rgba(0,0,0,0.9)]"
        draggable="false"
      />
    </div>
    
  </div>
  
</nav>

<style>
  /* Estados del texto activo */
  .nav-label.active span.font-display {
    color: #ffffff;
    text-shadow: 0 0 15px rgba(255, 255, 255, 0.4);
  }
  .nav-label.active .pointer-indicator {
    opacity: 1;
  }

  /* Animaciones del Hint (Desliza / Scroll) */
  @keyframes swipe-hand {
    0%   { transform: translateX(15px); opacity: 0; }
    20%  { opacity: 1; }
    80%  { opacity: 1; }
    100% { transform: translateX(-15px); opacity: 0; }
  }
  .animate-swipe-hand { animation: swipe-hand 2s infinite ease-in-out; }

  @keyframes scroll-mouse {
    0%   { transform: translateY(0); opacity: 1; }
    100% { transform: translateY(6px); opacity: 0; }
  }
  .animate-scroll-wheel { animation: scroll-mouse 1.5s infinite; }

  /* Flechas móviles: empujan hacia su lado hasta la primera interacción */
  @keyframes nudge-left  { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(-5px); } }
  @keyframes nudge-right { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(5px); } }
  #reel-nav-container:not(.has-interacted) .reel-arrow-left  { animation: nudge-left 1.2s ease-in-out infinite; }
  #reel-nav-container:not(.has-interacted) .reel-arrow-right { animation: nudge-right 1.2s ease-in-out infinite; }
  .reel-arrow[disabled] { opacity: 0.2; cursor: default; }

  @media (prefers-reduced-motion: reduce) {
    .animate-swipe-hand, .animate-scroll-wheel, .reel-arrow { animation: none !important; }
  }
</style>

<script>
  const labels = document.querySelectorAll('.nav-label');
  const totalItems = labels.length;
  const degreesPerStep = totalItems > 0 ? 360 / totalItems : 60; 

  const rotator = document.getElementById('reel-rotator');
  const navContainer = document.getElementById('reel-nav-container');
  const interactionHint = document.getElementById('interaction-hint');

  const swipeZone = document.getElementById('reel-swipe-zone');
  const arrowPrev = document.getElementById('reel-prev') as HTMLButtonElement | null;
  const arrowNext = document.getElementById('reel-next') as HTMLButtonElement | null;

  let currentIndex = 0;
  let currentRotation = 0;
  let hasInteracted = false;

  // Capas que se abren encima (detalle de proyecto, galería, estantería, SETUP) llevan
  // data-reel-lock. Mientras alguna esté visible, el carrete no lee scroll ni arrastre.
  function isLocked() {
    return Array.from(document.querySelectorAll('[data-reel-lock]'))
      // getClientRects vacío = el elemento o algún ancestro tiene display:none
      .some(el => el.getClientRects().length > 0);
  }

  // Función para desaparecer el indicador
  function hideHint() {
    if (!hasInteracted && interactionHint) {
      hasInteracted = true;
      navContainer?.classList.add('has-interacted');
      interactionHint.style.opacity = '0';
      setTimeout(() => interactionHint.remove(), 1000);
    }
  }

  // Empujón de muestra: el carrete y el texto se asoman hacia la siguiente sección
  // para que se entienda que el menú se mueve. Solo hasta la primera interacción.
  function peek() {
    if (hasInteracted || isLocked() || !rotator) return;
    const isDesktop = window.innerWidth >= 1024;
    const activeLabel = labels[currentIndex] as HTMLElement;

    rotator.style.transition = 'transform 0.35s cubic-bezier(0.25, 1, 0.5, 1)';
    rotator.style.transform = `rotate(${currentRotation - 14}deg)`;
    if (activeLabel) {
      activeLabel.style.transition = 'transform 0.35s cubic-bezier(0.25, 1, 0.5, 1)';
      activeLabel.style.transform = isDesktop ? 'translateY(-12px) scale(1.15)' : 'translateX(-24px) scale(1.15)';
    }

    setTimeout(() => {
      rotator.style.transition = 'transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1)';
      rotator.style.transform = `rotate(${currentRotation}deg)`;
      if (activeLabel) {
        activeLabel.style.transition = 'transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1)';
        activeLabel.style.transform = isDesktop ? 'translateY(0px) scale(1.15)' : 'translateX(0px) scale(1.15)';
      }
    }, 350);
  }

  // Renderizado dinámico de los textos centrados
  function renderTexts() {
    const isDesktop = window.innerWidth >= 1024;

    labels.forEach((label, i) => {
      const diff = i - currentIndex;
      const absDiff = Math.abs(diff);

      if (absDiff > 2) {
        (label as HTMLElement).style.opacity = '0';
        (label as HTMLElement).style.pointerEvents = 'none';
        return;
      }

      const scale = absDiff === 0 ? 1.15 : 0.85 - (absDiff * 0.1);
      // Los vecinos inmediatos se ven y se pueden tocar: dejan claro que hay más secciones a los lados
      const opacity = absDiff === 0 ? 1 : absDiff === 1 ? 0.45 : 0.12;

      (label as HTMLElement).style.opacity = opacity.toString();
      (label as HTMLElement).style.pointerEvents = absDiff <= 1 ? 'auto' : 'none';

      if (isDesktop) {
        const yOffset = diff * 55;
        (label as HTMLElement).style.transform = `translateY(${yOffset}px) scale(${scale})`;
      } else {
        const xOffset = diff * 110;
        (label as HTMLElement).style.transform = `translateX(${xOffset}px) scale(${scale})`;
      }

      if (absDiff === 0) {
        label.classList.add('active');
        const targetId = label.getAttribute('data-target');
        document.dispatchEvent(new CustomEvent('visor-change', { detail: targetId }));
      } else {
        label.classList.remove('active');
      }
    });

    if (arrowPrev) arrowPrev.disabled = currentIndex === 0;
    if (arrowNext) arrowNext.disabled = currentIndex === totalItems - 1;
  }

  // Animación de REBOTE cuando se llega al límite (Inicio o Fin)
  function bounceLimit(direction) {
    if (!rotator) return;
    hideHint(); 
    
    const bounceAngle = direction === -1 ? 20 : -20; 
    
    rotator.style.transition = 'transform 0.15s cubic-bezier(0.25, 1, 0.5, 1)';
    rotator.style.transform = `rotate(${currentRotation + bounceAngle}deg)`;
    
    const activeLabel = labels[currentIndex] as HTMLElement;
    if (activeLabel) {
       activeLabel.style.transition = 'transform 0.15s cubic-bezier(0.25, 1, 0.5, 1)';
       const isDesktop = window.innerWidth >= 1024;
       activeLabel.style.transform = isDesktop ? `translateY(0px) scale(1.05)` : `translateX(0px) scale(1.05)`;
    }

    setTimeout(() => {
      rotator.style.transition = 'transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1)'; 
      rotator.style.transform = `rotate(${currentRotation}deg)`;
      
      if (activeLabel) {
         activeLabel.style.transition = 'transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1)';
         const isDesktop = window.innerWidth >= 1024;
         activeLabel.style.transform = isDesktop ? `translateY(0px) scale(1.15)` : `translateX(0px) scale(1.15)`;
      }
    }, 150);
  }

  // Navegación principal
  function updateNavigation(newIndex, animateSVG = true) {
    if (newIndex < 0) {
      bounceLimit(-1);
      return;
    }
    if (newIndex >= totalItems) {
      bounceLimit(1);
      return;
    }
    
    if (animateSVG && rotator) {
      const diff = newIndex - currentIndex;
      currentRotation -= (diff * degreesPerStep);
      
      rotator.style.transition = 'transform 0.5s cubic-bezier(0.25, 1, 0.5, 1)';
      rotator.style.transform = `rotate(${currentRotation}deg)`;
    }

    currentIndex = newIndex;
    renderTexts();
  }

  renderTexts();
  window.addEventListener('resize', renderTexts);

  labels.forEach((label, i) => {
    label.addEventListener('click', () => {
      hideHint(); 
      updateNavigation(i);
    });
  });

  // SCROLL DEL MOUSE STRICTO
  let isWheelLocked = false;

  window.addEventListener('wheel', (e) => {
    if (isLocked()) return;
    hideHint();
    if (isWheelLocked) return;
    
    if (Math.abs(e.deltaY) < 15) return; 

    isWheelLocked = true;
    
    if (e.deltaY > 0) updateNavigation(currentIndex + 1);
    if (e.deltaY < 0) updateNavigation(currentIndex - 1);

    setTimeout(() => {
      isWheelLocked = false;
    }, 600);
    
  }, { passive: true });

  // ARRASTRE UNIVERSAL 1x1 CON TOPES
  let isDragging = false;
  let startPos = 0;
  let swipeLocked = false;

  const onPointerDown = (e) => {
    if (e.button !== undefined && e.button !== 0) return;
    if (isLocked()) return;

    hideHint(); 
    isDragging = true;
    swipeLocked = false;
    const isDesktop = window.innerWidth >= 1024;
    startPos = isDesktop ? e.clientY : e.clientX;
  };

  const onPointerMove = (e) => {
    if (!isDragging || swipeLocked || !rotator) return;

    const isDesktop = window.innerWidth >= 1024;
    const currentPos = isDesktop ? e.clientY : e.clientX;
    const delta = isDesktop ? (currentPos - startPos) : -(currentPos - startPos);

    if (Math.abs(delta) > 40) {
      const stepDirection = delta > 0 ? 1 : -1;
      const nextIndex = currentIndex + stepDirection;
      
      updateNavigation(nextIndex, true);
      swipeLocked = true; 
    }
  };

  const onPointerUp = () => {
    isDragging = false;
  };

  if (rotator) rotator.addEventListener('pointerdown', onPointerDown);
  if (swipeZone) swipeZone.addEventListener('pointerdown', onPointerDown);

  arrowPrev?.addEventListener('click', () => { hideHint(); updateNavigation(currentIndex - 1); });
  arrowNext?.addEventListener('click', () => { hideHint(); updateNavigation(currentIndex + 1); });

  setTimeout(peek, 1200);
  setTimeout(peek, 5000);
  window.addEventListener('pointermove', onPointerMove);
  window.addEventListener('pointerup', onPointerUp);
  window.addEventListener('pointercancel', onPointerUp);
</script>