---
import data from '../../data/experiencia.json';

// Lógica para ocultar flechas en web si hay 2 o menos items
const hideArrowsOnWeb = data.trabajos.length <= 2 ? 'lg:hidden' : 'lg:flex';
---

<article class="camera-focus-view relative w-full h-full flex flex-col justify-start lg:justify-center p-4 pt-14 lg:pt-0 pb-44 lg:pb-0 z-10 select-none">
  
  <div class="max-w-[700px] w-full mx-auto relative p-4 sm:p-8">
    
    <div class="absolute top-0 left-0 w-6 h-6 border-t-2 border-l-2 border-white/30 pointer-events-none"></div>
    <div class="absolute top-0 right-0 w-6 h-6 border-t-2 border-r-2 border-white/30 pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-6 h-6 border-b-2 border-l-2 border-white/30 pointer-events-none"></div>
    <div class="absolute bottom-0 right-0 w-6 h-6 border-b-2 border-r-2 border-white/30 pointer-events-none"></div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 mt-2">
      
      <!-- COLUMNA IZQUIERDA: Menú de Archivos (SLIDER) -->
      <div class="lg:col-span-5 flex flex-col relative w-full group">
        
        <!-- Flecha Anterior (SVG) -->
        <button class={`scroll-prev-btn absolute -left-6 top-1/2 -translate-y-1/2 lg:static lg:translate-y-0 lg:left-auto lg:w-full lg:mb-1 z-20 flex items-center justify-center p-2 lg:p-1 text-white/30 hover:text-pink-500 transition-colors pointer-events-auto bg-black/80 lg:bg-transparent rounded-full lg:rounded-none border border-white/10 lg:border-none ${hideArrowsOnWeb}`}>
           <svg viewBox="0 0 24 24" fill="currentColor" class="w-3 h-3 rotate-180 lg:rotate-[-90deg]">
             <path d="M8 5v14l11-7z"/>
           </svg>
        </button>

        <div id="exp-tab-slider" class="slider-mask flex flex-row lg:flex-col gap-3 overflow-x-auto lg:overflow-x-hidden lg:overflow-y-auto snap-x snap-mandatory lg:snap-y scroll-smooth scrollbar-hide w-full lg:h-[192px] relative z-10 px-1 lg:px-0">
          {data.trabajos.map((trabajo, index) => (
            <button 
              class={`exp-tab snap-center lg:snap-start flex-shrink-0 w-[62%] lg:w-full h-[72px] text-left flex flex-col justify-center p-3 border-l-2 transition-all duration-300 pointer-events-auto ${index === 0 ? 'border-pink-500 bg-white/5' : 'border-white/10 hover:border-white/40 hover:bg-white/5'}`}
              data-target={trabajo.id}
            >
              <span class={`font-mono text-[9px] md:text-[10px] tracking-widest mb-1 transition-colors whitespace-nowrap overflow-hidden text-ellipsis ${index === 0 ? 'text-pink-400' : 'text-white/40'}`}>
                > {trabajo.periodo}
              </span>
              <span class={`font-display text-sm md:text-base uppercase tracking-wider transition-colors whitespace-nowrap overflow-hidden text-ellipsis ${index === 0 ? 'text-white drop-shadow-[0_0_5px_rgba(255,255,255,0.8)]' : 'text-white/60'}`}>
                {trabajo.empresa}
              </span>
            </button>
          ))}
        </div>

        <!-- Flecha Siguiente (SVG) -->
        <button class={`scroll-next-btn absolute -right-6 top-1/2 -translate-y-1/2 lg:static lg:translate-y-0 lg:right-auto lg:w-full lg:mt-1 z-20 flex items-center justify-center p-2 lg:p-1 text-white/30 hover:text-pink-500 transition-colors pointer-events-auto bg-black/80 lg:bg-transparent rounded-full lg:rounded-none border border-white/10 lg:border-none ${hideArrowsOnWeb}`}>
           <svg viewBox="0 0 24 24" fill="currentColor" class="w-3 h-3 lg:rotate-90">
             <path d="M8 5v14l11-7z"/>
           </svg>
        </button>

      </div>

      <!-- COLUMNA DERECHA: Visor de Contenido -->
      <div class="lg:col-span-7 relative min-h-[220px]">
        {data.trabajos.map((trabajo, index) => (
          <div 
            id={trabajo.id}
            class={`exp-content absolute inset-0 flex flex-col transition-all duration-500 ${index === 0 ? 'opacity-100 translate-y-0 pointer-events-auto' : 'opacity-0 translate-y-4 pointer-events-none'}`}
          >
            <h3 class="font-mono text-xs md:text-sm text-cyan-400 uppercase tracking-widest mb-2">
              ROL: <span class="text-white">{trabajo.rol}</span>
            </h3>
            
            <p class="font-sans text-white/80 text-xs md:text-sm leading-relaxed font-light mb-4">
              {trabajo.descripcion}
            </p>

           {trabajo.botonTexto && (
              <a 
                href={trabajo.botonUrl} 
                target="_blank" 
                rel="noopener noreferrer"
                class="glitch-action-link group inline-flex items-center gap-2 font-mono text-xs md:text-sm text-white uppercase tracking-widest mb-4 pointer-events-auto w-max"
              >
                {/* Flecha SVG del botón */}
                <svg viewBox="0 0 24 24" fill="currentColor" class="w-2.5 h-2.5 md:w-3 md:h-3 text-pink-500 group-hover:drop-shadow-[0_0_8px_rgba(236,72,153,1)] transition-all">
                  <path d="M8 5v14l11-7z"/>
                </svg>
                <span class="glitch-text font-bold">{trabajo.botonTexto}</span>
              </a>
            )}

            <div class="mt-2 md:mt-4">
              <div class="flex flex-wrap gap-3 sm:gap-4">
                {trabajo.tecnologias.map((tech) => (
                  <div class="skill-container group relative flex flex-col items-center justify-center pointer-events-auto">
                    
                    <div 
                      class="icon-sharp w-5 h-5 sm:w-6 sm:h-6 bg-white/40 group-hover:bg-pink-500 group-hover:scale-125 group-active:scale-125 transition-all duration-300 drop-shadow-[0_0_0px_transparent] group-hover:drop-shadow-[0_0_12px_rgba(236,72,153,0.9)]"
                      style={`
                        mask-image: url('${tech.icono}');
                        -webkit-mask-image: url('${tech.icono}');
                        mask-size: contain;
                        mask-repeat: no-repeat;
                        mask-position: center;
                        -webkit-mask-size: contain;
                        -webkit-mask-repeat: no-repeat;
                        -webkit-mask-position: center;
                      `}
                    ></div>

                    <span class="skill-label absolute -bottom-5 left-1/2 -translate-x-1/2 font-mono text-[8px] text-pink-300 uppercase tracking-widest whitespace-nowrap opacity-0 pointer-events-none transition-all duration-300 bg-black/80 px-2 py-0.5 rounded-sm z-20">
                      {tech.nombre}
                    </span>

                  </div>
                ))}
              </div>
            </div>

          </div>
        ))}
      </div>

    </div>

  </div>
</article>

<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }

  .slider-mask {
    mask-image: linear-gradient(to right, black 85%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, black 85%, transparent 100%);
  }
  @media (min-width: 1024px) {
    .slider-mask {
      mask-image: linear-gradient(to bottom, black 80%, transparent 100%);
      -webkit-mask-image: linear-gradient(to bottom, black 80%, transparent 100%);
    }
  }

  .glitch-text {
    animation: rgb-jitter-idle 2s linear infinite alternate;
    color: rgba(255, 255, 255, 0.9);
  }
  .glitch-action-link:hover .glitch-text,
  .glitch-action-link:active .glitch-text {
    color: white;
    animation: rgb-jitter-active 0.15s linear infinite alternate;
  }
  @keyframes rgb-jitter-idle {
    0% { text-shadow: -1px 0 0 rgba(0, 255, 255, 0.4), 1px 0 0 rgba(255, 0, 255, 0.4); }
    100% { text-shadow: 1px 0 0 rgba(0, 255, 255, 0.4), -1px 0 0 rgba(255, 0, 255, 0.4); }
  }
  @keyframes rgb-jitter-active {
    0% { text-shadow: -2px 0 0 rgba(0, 255, 255, 0.9), 2px 0 0 rgba(255, 0, 255, 0.9); }
    50% { text-shadow: 2px 0 0 rgba(0, 255, 255, 0.9), -2px 0 0 rgba(255, 0, 255, 0.9); }
    100% { text-shadow: -1px 0 1px rgba(0, 255, 255, 0.9), 1px 0 1px rgba(255, 0, 255, 0.9); }
  }

  @keyframes camera-ready {
    0% { opacity: 0; filter: blur(15px) brightness(2); transform: scale(1.05); }
    100% { opacity: 1; filter: blur(0px) brightness(1); transform: scale(1); }
  }
  .camera-focus-view {
    animation: camera-ready 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .icon-sharp { shape-rendering: crispEdges; transform: translateZ(0); -webkit-font-smoothing: none; }

  .skill-label { filter: blur(8px); will-change: filter, opacity, transform; }
  .skill-container:hover .skill-label, .skill-container.is-active .skill-label {
    opacity: 1; filter: blur(0px); transform: translate(-50%, -4px); color: #ffffff; text-shadow: 0 0 8px rgba(236, 72, 153, 0.8);
  }
</style>

<script>
  const tabs = Array.from(document.querySelectorAll('.exp-tab'));
  const contents = document.querySelectorAll('.exp-content');
  const prevBtns = document.querySelectorAll('.scroll-prev-btn');
  const nextBtns = document.querySelectorAll('.scroll-next-btn');
  
  let activeIndex = 0;

  // Función centralizada para cambiar de pestaña y hacer scroll
  function activateTab(index) {
    if (index < 0 || index >= tabs.length) return;
    activeIndex = index;
    const selectedTab = tabs[index];

    // Limpiar estilos de todas las pestañas
    tabs.forEach(t => {
      t.classList.remove('border-pink-500', 'bg-white/5');
      t.classList.add('border-white/10');
      t.querySelector('span:first-child').classList.replace('text-pink-400', 'text-white/40');
      t.querySelector('span:last-child').classList.replace('text-white', 'text-white/60');
      t.querySelector('span:last-child').classList.remove('drop-shadow-[0_0_5px_rgba(255,255,255,0.8)]');
    });

    // Activar la pestaña seleccionada
    selectedTab.classList.remove('border-white/10');
    selectedTab.classList.add('border-pink-500', 'bg-white/5');
    selectedTab.querySelector('span:first-child').classList.replace('text-white/40', 'text-pink-400');
    selectedTab.querySelector('span:last-child').classList.replace('text-white/60', 'text-white');
    selectedTab.querySelector('span:last-child').classList.add('drop-shadow-[0_0_5px_rgba(255,255,255,0.8)]');

    // Cambiar contenido visible
    const targetId = selectedTab.getAttribute('data-target');
    contents.forEach(content => {
      if (content.id === targetId) {
        content.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
        content.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
      } else {
        content.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
        content.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
      }
    });

    // Centrar la pestaña en el contenedor visible
    selectedTab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
  }

  // Eventos para clics manuales en las pestañas
  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => activateTab(index));
  });

  // Eventos para las flechas de navegación
  prevBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      if (activeIndex > 0) activateTab(activeIndex - 1);
    });
  });

  nextBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      if (activeIndex < tabs.length - 1) activateTab(activeIndex + 1);
    });
  });

  // Efecto tooltips en móvil
  const skillContainers = document.querySelectorAll('.skill-container');
  skillContainers.forEach((container) => {
    container.addEventListener('touchstart', () => {
      skillContainers.forEach(c => c.classList.remove('is-active'));
      container.classList.add('is-active');
      setTimeout(() => container.classList.remove('is-active'), 3000);
    }, { passive: true });
  });
</script>