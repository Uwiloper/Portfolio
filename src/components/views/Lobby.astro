---
import playlist from '../../data/playlist.json';

// Las pistas se sirven desde public/audio/ salvo que PUBLIC_AUDIO_BASE apunte a otro lugar (ej. Cloudflare R2)
const base = (import.meta.env.PUBLIC_AUDIO_BASE ?? '/audio/').replace(/\/?$/, '/');
const pistas = playlist.canciones.map(({ id, titulo, artista, duracion, archivo }) => ({
  id, titulo, artista, duracion, src: base + archivo,
}));
---

<article id="lobby-player" data-pistas={JSON.stringify(pistas)} data-cinta={playlist.cinta} class="camera-focus-view relative w-full h-full flex flex-col items-center justify-center p-4 lg:p-0 z-10 select-none pb-40 lg:pb-0">
  
  <div class="w-full max-w-[400px] flex flex-col items-center gap-8 relative">
    
    <!-- Título y Estado -->
    <div class="w-full flex justify-between items-end border-b border-white/20 pb-2 px-2">
      <h2 class="font-display text-xl text-white uppercase tracking-widest italic drop-shadow-[0_0_8px_rgba(255,255,255,0.3)]">
        {playlist.tituloPlaylist}
      </h2>
      <div class="flex items-center gap-2">
        <div id="status-dot" class="w-2 h-2 rounded-full bg-red-500 shadow-[0_0_8px_rgba(239,68,68,0.8)] animate-pulse"></div>
        <span id="player-status" class="font-mono text-[10px] text-white/50 tracking-widest uppercase">PAUSED</span>
      </div>
    </div>

    <!-- EL REPRODUCTOR DE CASSETTE -->
    <div class="w-full bg-[#cbd5e1] rounded-2xl p-6 shadow-2xl relative border-b-8 border-r-8 border-[#94a3b8] flex flex-col gap-6">
      
      <!-- Rejilla del altavoz -->
      <div class="w-full flex flex-col gap-1.5 opacity-40">
        <div class="w-full h-1 bg-black rounded-full"></div>
        <div class="w-full h-1 bg-black rounded-full"></div>
        <div class="w-full h-1 bg-black rounded-full"></div>
        <div class="w-full h-1 bg-black rounded-full"></div>
        <div class="w-full h-1 bg-black rounded-full"></div>
      </div>

      <!-- Hueco del Cassette -->
      <div class="w-full bg-[#111] rounded-lg h-32 p-3 shadow-[inset_0_10px_20px_rgba(0,0,0,0.8)] relative border border-white/10 flex items-center justify-center overflow-hidden">
        
        <!-- Textura plástica interior -->
        <div class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_center,_white_1px,_transparent_1px)] bg-[size:4px_4px]"></div>

        <!-- El Cassette (Visual) -->
        <div class="w-[85%] h-[80%] bg-zinc-900 rounded-md border border-zinc-700 relative flex justify-between items-center px-4 shadow-lg">
          <!-- Etiqueta del casete -->
          <div class="absolute top-2 left-1/2 -translate-x-1/2 w-3/4 h-6 bg-pink-500/20 border border-pink-500/50 flex items-center justify-center">
             <!-- Marquesina con el nombre de la canción -->
             <div class="w-full overflow-hidden whitespace-nowrap px-2">
                <span id="track-marquee" class="font-mono text-[8px] text-pink-300 tracking-widest uppercase inline-block">
                   [ {pistas[0]?.titulo} ] - READY TO PLAY
                </span>
             </div>
          </div>

          <!-- Rollo Izquierdo -->
          <div class="w-8 h-8 rounded-full bg-zinc-800 border-2 border-zinc-600 flex items-center justify-center shadow-inner relative z-10">
             <div class="tape-gear w-6 h-6 rounded-full flex items-center justify-center relative">
               <!-- Dientes del engranaje -->
               <div class="w-1.5 h-1.5 bg-zinc-400 rounded-full absolute top-0"></div>
               <div class="w-1.5 h-1.5 bg-zinc-400 rounded-full absolute bottom-0"></div>
               <div class="w-1.5 h-1.5 bg-zinc-400 rounded-full absolute left-0"></div>
               <div class="w-1.5 h-1.5 bg-zinc-400 rounded-full absolute right-0"></div>
             </div>
          </div>

          <!-- Puente central inferior del casete -->
          <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-1/3 h-4 bg-zinc-800 border-t border-x border-zinc-700 rounded-t-sm flex items-end justify-center pb-1 gap-2">
             <div class="w-2 h-2 rounded-full bg-black/50"></div>
             <div class="w-2 h-2 rounded-full bg-black/50"></div>
          </div>

          <!-- Rollo Derecho -->
          <div class="w-8 h-8 rounded-full bg-zinc-800 border-2 border-zinc-600 flex items-center justify-center shadow-inner relative z-10">
             <div class="tape-gear w-6 h-6 rounded-full flex items-center justify-center relative">
               <div class="w-1.5 h-1.5 bg-zinc-400 rounded-full absolute top-0"></div>
               <div class="w-1.5 h-1.5 bg-zinc-400 rounded-full absolute bottom-0"></div>
               <div class="w-1.5 h-1.5 bg-zinc-400 rounded-full absolute left-0"></div>
               <div class="w-1.5 h-1.5 bg-zinc-400 rounded-full absolute right-0"></div>
             </div>
          </div>
        </div>

      </div>

      <!-- Botones de Control Mecánicos -->
      <div class="flex justify-between gap-2 mt-2">
        
        <button id="btn-prev" aria-label="Pista anterior" class="player-btn flex-1 bg-[#e2e8f0] border-b-4 border-r-2 border-[#94a3b8] py-3 rounded-sm flex items-center justify-center active:border-0 active:translate-y-1 active:translate-x-0.5 transition-all text-zinc-500 hover:text-pink-500">
          <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>
        </button>

        <button id="btn-play-pause" aria-label="Reproducir" class="player-btn flex-1 bg-[#e2e8f0] border-b-4 border-r-2 border-[#94a3b8] py-3 rounded-sm flex items-center justify-center active:border-0 active:translate-y-1 active:translate-x-0.5 transition-all text-zinc-500 hover:text-pink-500">
          <!-- Icono Play por defecto -->
          <svg id="icon-play" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6"><path d="M8 5v14l11-7z"/></svg>
          <!-- Icono Pausa oculto -->
          <svg id="icon-pause" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 hidden"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
        </button>

        <button id="btn-next" aria-label="Pista siguiente" class="player-btn flex-1 bg-[#e2e8f0] border-b-4 border-r-2 border-[#94a3b8] py-3 rounded-sm flex items-center justify-center active:border-0 active:translate-y-1 active:translate-x-0.5 transition-all text-zinc-500 hover:text-pink-500">
          <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 rotate-180"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>
        </button>

      </div>

    </div>

  </div>
  
</article>

<style>
  /* Animación para que los rollos giren cuando está en PLAY */
  .is-playing .tape-gear {
    animation: spin-gear 3s linear infinite;
  }
  
  @keyframes spin-gear {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Animación del texto estilo marquesina de LED */
  .is-playing #track-marquee {
    animation: scroll-marquee 10s linear infinite;
  }

  @keyframes scroll-marquee {
    0%   { transform: translateX(100%); }
    100% { transform: translateX(-150%); }
  }
</style>

<script>
  // Lobby FM: este script solo refleja el estado del motor (src/js/cassette.ts) en el reproductor.
  // El deck definitivo (bobinas, contador, arrastre) llega en el paso de diseño.
  import { crearCinta, type Pista } from '../../js/cassette';

  const player = document.getElementById('lobby-player');
  const pistas: Pista[] = JSON.parse(player?.dataset.pistas || '[]');
  const cinta = crearCinta(pistas, player?.dataset.cinta);

  const btnPrev = document.getElementById('btn-prev');
  const btnPlay = document.getElementById('btn-play-pause');
  const btnNext = document.getElementById('btn-next');
  const iconPlay = document.getElementById('icon-play');
  const iconPause = document.getElementById('icon-pause');
  const marquee = document.getElementById('track-marquee');
  const statusText = document.getElementById('player-status');
  const statusDot = document.getElementById('status-dot');

  function pintarEstado() {
    const sonando = cinta.sonando;
    player?.classList.toggle('is-playing', sonando);
    iconPlay?.classList.toggle('hidden', sonando);
    iconPause?.classList.toggle('hidden', !sonando);
    btnPlay?.setAttribute('aria-label', sonando ? 'Pausar' : 'Reproducir');

    const [texto, color] = cinta.sinSenal ? ['NO SIGNAL', 'bg-red-500']
      : cinta.cargando ? ['LOADING', 'bg-amber-400']
      : sonando ? ['PLAYING', 'bg-green-400']
      : cinta.estado === 'avanzando' ? ['FF ▶▶', 'bg-amber-400']
      : cinta.estado === 'rebobinando' ? ['◀◀ REW', 'bg-amber-400']
      : ['PAUSED', 'bg-red-500'];
    if (statusText) statusText.textContent = texto;
    statusDot?.classList.remove('bg-red-500', 'bg-green-400', 'bg-amber-400');
    statusDot?.classList.add(color);

    const pista = cinta.pistas[cinta.indiceEn(cinta.posicion)];
    if (marquee && pista) marquee.textContent = `[ ${pista.titulo} ] - ${cinta.sinSenal ? 'SIN SEÑAL' : sonando ? 'NOW PLAYING' : 'READY TO PLAY'}`;
  }

  cinta.addEventListener('estado', pintarEstado);
  cinta.addEventListener('pista', pintarEstado);

  if (pistas.length > 0) {
    btnPlay?.addEventListener('click', () => cinta.alternar());
    btnPrev?.addEventListener('click', () => cinta.anterior());
    btnNext?.addEventListener('click', () => cinta.siguiente());
  }

  // Solo en desarrollo: acceso desde la consola para probar el motor
  if (import.meta.env.DEV) (window as unknown as { cinta: typeof cinta }).cinta = cinta;
</script>