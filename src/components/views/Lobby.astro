---
import playlistOficial from '../../data/playlist.json';
import DeckCassette from '../DeckCassette.astro';

// Si existe playlist.local.json (ignorado por git) se usa en su lugar: sirve para probar
// en local con otras pistas sin que lleguen al repo ni a producción.
const locales = import.meta.glob<typeof playlistOficial>('../../data/playlist.local.json', { eager: true, import: 'default' });
const playlist = Object.values(locales)[0] ?? playlistOficial;

// Las pistas se sirven desde public/audio/ salvo que PUBLIC_AUDIO_BASE apunte a otro lugar (ej. Cloudflare R2)
const base = (import.meta.env.PUBLIC_AUDIO_BASE ?? '/audio/').replace(/\/?$/, '/');
const pistas = playlist.canciones.map(({ id, titulo, artista, duracion, archivo }) => ({
  id, titulo, artista, duracion, src: base + archivo,
}));
---

<article class="camera-focus-view relative w-full h-full flex flex-col items-center justify-start lg:justify-center gap-5 p-4 pt-14 lg:pt-0 pb-44 lg:pb-0 z-10 select-none overflow-y-auto lg:overflow-visible">
  <header class="w-full max-w-[680px] border-b border-white/10 pb-2">
    <h2 class="font-display text-xl md:text-2xl text-white uppercase tracking-widest italic drop-shadow-[0_0_10px_rgba(255,255,255,0.3)]">
      {playlist.tituloPlaylist}
    </h2>
  </header>

  <DeckCassette pistas={pistas} cinta={playlist.cinta} lado={playlist.lado} />
</article>
