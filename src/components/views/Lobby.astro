---
import playlistOficial from '../../data/playlist.json';
import tv from '../../data/tv.json';
import DeckCassette from '../DeckCassette.astro';
import TvLobby from '../TvLobby.astro';

// Si existe playlist.local.json (ignorado por git) se usa en su lugar: sirve para probar
// en local con otras pistas sin que lleguen al repo ni a producción.
type Cancion = { id: string; titulo: string; artista: string; duracion: number; archivo: string };
type Playlist = { tituloPlaylist: string; cinta: string; lado: string; canciones: Cancion[] };
const locales = import.meta.glob<Playlist>('../../data/playlist.local.json', { eager: true, import: 'default' });
// Sin canciones (lista oficial vacía), el deck se muestra en modo "PRÓXIMAMENTE"
const playlist: Playlist = Object.values(locales)[0] ?? playlistOficial;

// Las pistas se sirven desde public/audio/ salvo que PUBLIC_AUDIO_BASE apunte a otro lugar (ej. Cloudflare R2)
const base = (import.meta.env.PUBLIC_AUDIO_BASE ?? '/audio/').replace(/\/?$/, '/');
const pistas = playlist.canciones.map(({ id, titulo, artista, duracion, archivo }) => ({
  id, titulo, artista, duracion, src: base + archivo,
}));
// Sin pistas propias, el deck se vuelve la videocasetera de la TV
const vcr = pistas.length === 0;
---

<article class:list={[
  'camera-focus-view relative w-full h-full flex flex-col items-center justify-start gap-4 p-4 pt-14 pb-44 z-10 select-none overflow-y-auto scrollbar-hide',
  vcr ? 'lg:justify-center lg:pt-0 lg:pb-0' : 'lg:pt-6 lg:pb-6',
]}>
  <header class="w-full max-w-[640px] border-b border-white/10 pb-2 shrink-0">
    <h2 class="font-display text-xl md:text-2xl text-white uppercase tracking-widest italic drop-shadow-[0_0_10px_rgba(255,255,255,0.3)]">
      {vcr ? tv.titulo : playlist.tituloPlaylist}
    </h2>
  </header>

  <TvLobby canales={tv.canales} />
  <DeckCassette pistas={pistas} cinta={playlist.cinta} lado={playlist.lado} vcr={vcr} />
</article>
