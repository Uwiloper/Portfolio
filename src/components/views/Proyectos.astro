---
import data from '../../data/proyectos.json';
---

<article class="camera-focus-view relative w-full h-full flex flex-col justify-start lg:justify-center p-4 pt-14 lg:pt-0 pb-52 lg:pb-0 z-10 select-none">
  
  <div class="max-w-[700px] w-full mx-auto relative p-6 sm:p-8 flex flex-col justify-center min-h-[420px]">
    
    <!-- Marcas de Cámara -->
    <div class="absolute top-0 left-0 w-6 h-6 border-t-2 border-l-2 border-white/30 pointer-events-none"></div>
    <div class="absolute top-0 right-0 w-6 h-6 border-t-2 border-r-2 border-white/30 pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-6 h-6 border-b-2 border-l-2 border-white/30 pointer-events-none"></div>
    <div class="absolute bottom-0 right-0 w-6 h-6 border-b-2 border-r-2 border-white/30 pointer-events-none"></div>

    <header class="mb-4 border-b border-white/10 pb-2">
      <h2 class="font-display text-xl md:text-2xl text-white uppercase tracking-widest italic drop-shadow-[0_0_10px_rgba(255,255,255,0.3)]">
        {data.titulo}
      </h2>
    </header>

    <!-- VISTA 1: CARRUSEL PRINCIPAL -->
    <div id="view-carousel" class="flex flex-col transition-all duration-500 opacity-100">
      
      <!-- Contenedor del Carrusel (Scrolleable) -->
      <div class="slider-mask flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-smooth scrollbar-hide py-4 w-full">
        {data.proyectos.map((proyecto) => (
        //   <!-- CAJA VHS -->
          <button class="vhs-box group relative flex-shrink-0 w-[160px] h-[240px] md:w-[180px] md:h-[260px] snap-center border-2 border-white/10 bg-black hover:border-white/40 transition-all duration-300 overflow-hidden pointer-events-auto text-left">
            
            {/* <!-- Etiqueta de color (Simula la calcomanía superior de la cinta) --> */}
            <div class={`absolute top-0 left-0 right-0 h-8 ${proyecto.color} flex items-center px-2 border-b-2 border-black`}>
              <span class="font-mono text-[8px] text-black font-bold tracking-widest">{proyecto.duracion}</span>
            </div>

            {/* <!-- Contenido de la Caja --> */}
            <div class="absolute inset-0 top-8 p-3 flex flex-col justify-between bg-[linear-gradient(to_bottom,rgba(255,255,255,0.05),transparent)]">
              <div>
                <span class="font-mono text-[9px] text-white/50 tracking-widest uppercase block mb-1">
                  > {proyecto.categoria}
                </span>
                <h3 class="font-display text-lg md:text-xl text-white tracking-widest uppercase leading-tight group-hover:drop-shadow-[0_0_8px_rgba(255,255,255,0.8)] transition-all">
                  {proyecto.titulo}
                </h3>
              </div>
              
              <div class="flex justify-between items-end border-t border-white/10 pt-2">
                <span class="font-mono text-[10px] text-white/40">[{proyecto.año}]</span>
                <span class="font-mono text-[9px] text-pink-500 uppercase tracking-widest group-hover:animate-pulse">PLAY ▶</span>
              </div>
            </div>

            {/* <!-- Efecto de desgaste/brillo en hover --> */}
            <div class="absolute inset-0 opacity-0 group-hover:opacity-100 bg-gradient-to-tr from-white/0 via-white/5 to-white/0 transition-opacity duration-500 pointer-events-none"></div>
          </button>
        ))}
      </div>

      <!-- Botón: VER ESTANTERÍA -->
      <div class="mt-4 flex justify-center sm:justify-end">
        <button id="btn-show-shelf" class="glitch-action-link group inline-flex items-center gap-2 font-mono text-xs md:text-sm text-white uppercase tracking-widest pointer-events-auto w-max">
          <svg viewBox="0 0 24 24" fill="currentColor" class="w-2.5 h-2.5 md:w-3 md:h-3 text-pink-500 group-hover:drop-shadow-[0_0_8px_rgba(236,72,153,1)] transition-all">
            <path d="M8 5v14l11-7z"/>
          </svg>
          <span class="glitch-text font-bold">{data.botonVerTodos}</span>
        </button>
      </div>

    </div>

    <!-- VISTA 2: ESTANTERÍA (Oculta por defecto) -->
    <div id="view-shelf" class="hidden flex-col transition-all duration-500 opacity-0 absolute inset-0 p-6 sm:p-8 bg-black/90 backdrop-blur-sm z-20 overflow-y-auto scrollbar-hide">
      
      <div class="flex justify-between items-center mb-6 border-b border-white/20 pb-2 sticky top-0 bg-black/90 z-10 pt-2">
        <span class="font-mono text-[10px] text-cyan-400 tracking-widest uppercase">> ESTANTERÍA DE DATOS</span>
        <!-- Botón: VOLVER -->
        <button id="btn-hide-shelf" class="glitch-action-link group inline-flex items-center gap-2 font-mono text-[10px] text-white uppercase tracking-widest pointer-events-auto">
          <svg viewBox="0 0 24 24" fill="currentColor" class="w-2.5 h-2.5 text-pink-500 rotate-180">
            <path d="M8 5v14l11-7z"/>
          </svg>
          <span class="glitch-text font-bold">{data.botonVolver}</span>
        </button>
      </div>

      <!-- Grid de la Repisa -->
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 pb-20">
        {data.proyectos.map((proyecto) => (
          <button class="relative w-full aspect-[2/3] border border-white/20 bg-black/60 hover:bg-white/5 hover:border-white/50 transition-all duration-300 flex flex-col items-center justify-center p-2 group pointer-events-auto">
             <div class={`w-full h-2 absolute top-0 left-0 ${proyecto.color}`}></div>
             <span class="font-mono text-[8px] text-white/40 mb-1">{proyecto.año}</span>
             <h3 class="font-display text-sm text-center text-white/80 group-hover:text-white uppercase px-1">{proyecto.titulo}</h3>
          </button>
        ))}
      </div>

    </div>

  </div>
</article>

<style>
  /* Scrollbar hide */
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }

  /* Máscara del slider principal */
  .slider-mask {
    mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
  }

  /* Efecto Glitch de los Botones (Reutilizado) */
  .glitch-text {
    animation: rgb-jitter-idle 2s linear infinite alternate;
    color: rgba(255, 255, 255, 0.9);
  }
  .glitch-action-link:hover .glitch-text,
  .glitch-action-link:active .glitch-text {
    color: white;
    animation: rgb-jitter-active 0.15s linear infinite alternate;
  }
  @keyframes rgb-jitter-idle {
    0% { text-shadow: -1px 0 0 rgba(0, 255, 255, 0.4), 1px 0 0 rgba(255, 0, 255, 0.4); }
    100% { text-shadow: 1px 0 0 rgba(0, 255, 255, 0.4), -1px 0 0 rgba(255, 0, 255, 0.4); }
  }
  @keyframes rgb-jitter-active {
    0% { text-shadow: -2px 0 0 rgba(0, 255, 255, 0.9), 2px 0 0 rgba(255, 0, 255, 0.9); }
    50% { text-shadow: 2px 0 0 rgba(0, 255, 255, 0.9), -2px 0 0 rgba(255, 0, 255, 0.9); }
    100% { text-shadow: -1px 0 1px rgba(0, 255, 255, 0.9), 1px 0 1px rgba(255, 0, 255, 0.9); }
  }

  @keyframes camera-ready {
    0% { opacity: 0; filter: blur(15px) brightness(2); transform: scale(1.05); }
    100% { opacity: 1; filter: blur(0px) brightness(1); transform: scale(1); }
  }
  .camera-focus-view {
    animation: camera-ready 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
</style>

<script>
  // Lógica para alternar entre el Carrusel y la Estantería
  const btnShow = document.getElementById('btn-show-shelf');
  const btnHide = document.getElementById('btn-hide-shelf');
  const viewCarousel = document.getElementById('view-carousel');
  const viewShelf = document.getElementById('view-shelf');

  if (btnShow && btnHide && viewCarousel && viewShelf) {
    btnShow.addEventListener('click', () => {
      // Ocultar carrusel
      viewCarousel.classList.replace('opacity-100', 'opacity-0');
      setTimeout(() => {
        viewCarousel.classList.add('hidden');
        viewCarousel.classList.remove('flex');
        
        // Mostrar repisa
        viewShelf.classList.remove('hidden');
        viewShelf.classList.add('flex');
        // Pequeño delay para que el navegador procese el display:flex antes de cambiar la opacidad
        setTimeout(() => {
          viewShelf.classList.replace('opacity-0', 'opacity-100');
        }, 50);
      }, 300); // 300ms es el tiempo de la transición
    });

    btnHide.addEventListener('click', () => {
      // Ocultar repisa
      viewShelf.classList.replace('opacity-100', 'opacity-0');
      setTimeout(() => {
        viewShelf.classList.add('hidden');
        viewShelf.classList.remove('flex');
        
        // Mostrar carrusel
        viewCarousel.classList.remove('hidden');
        viewCarousel.classList.add('flex');
        setTimeout(() => {
          viewCarousel.classList.replace('opacity-0', 'opacity-100');
        }, 50);
      }, 300);
    });
  }
</script>