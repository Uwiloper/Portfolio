---
import Layout from      '../layouts/Layout.astro';
import ReelNavbar from  '../components/ReelNavbar.astro';
import SobreMi from     '../components/views/SobreMi.astro'; 
import Experiencia from '../components/views/Experiencia.astro';
import Contacto from    '../components/views/Contacto.astro';
import Proyectos from   '../components/views/Proyectos.astro';
---

<Layout title="Wilmer Carrasco | Inicio">
  
  <!-- GLITCH DIGITAL OVERLAY (Abarca TODA la pantalla por estar fuera del main) -->
  <div id="true-glitch-overlay" class="fixed inset-0 pointer-events-none z-[9999] hidden overflow-hidden">
      <div class="glitch-band glitch-band-1"></div>
      <div class="glitch-band glitch-band-2"></div>
      <div class="glitch-band glitch-band-3"></div>
      <!-- Capa de ruido de estática fullscreen -->
      <div class="absolute inset-0 opacity-15 mix-blend-overlay" style="background: repeating-linear-gradient(transparent, transparent 2px, rgba(255,255,255,0.4) 2px, rgba(255,255,255,0.4) 4px);"></div>
  </div>

  <!-- AHORA EL GLITCH SACUDE TODO EL MAIN (Visor + Rueda) -->
  <main id="main-layout" class="relative z-20 w-full min-h-screen flex flex-col lg:flex-row pointer-events-none">
     
     <section class="w-full lg:w-[60%] xl:w-[65%] h-screen flex items-center justify-center pointer-events-auto p-4 sm:p-6 md:p-12 relative overflow-hidden">
        
        <!-- EL VISOR DE LA CÁMARA -->
        <div id="camera-visor" class="w-full h-full max-w-4xl relative flex items-center justify-center">  
            
            <div class="visor-view w-full h-full" data-view="sobre-mi">
                <SobreMi />
            </div>

            <div class="visor-view w-full h-full hidden" data-view="experiencia">
                <Experiencia />
            </div>

            <div class="visor-view w-full h-full hidden" data-view="proyectos">
                <Proyectos />
            </div>

            <div class="visor-view w-full h-full hidden" data-view="contacto">
                <Contacto />
            </div>

        </div>

     </section>
     
     <ReelNavbar />
     
  </main>

</Layout>

<script>
  // EL RECEPTOR DE SEÑAL Y CONTROLADOR DEL "TRUE FULLSCREEN GLITCH"
  const mainLayout = document.getElementById('main-layout');
  const glitchOverlay = document.getElementById('true-glitch-overlay');

  document.addEventListener('visor-change', (e) => {
    const targetView = (e as CustomEvent).detail; 
    const allViews = document.querySelectorAll('.visor-view');

    if (mainLayout && glitchOverlay) {
      
      // 1. Distorsionar y sacudir TODO EL LAYOUT (incluyendo ReelNavbar)
      mainLayout.classList.remove('is-digital-glitching');
      void mainLayout.offsetWidth; 
      mainLayout.classList.add('is-digital-glitching');

      // 2. Activar la capa Fullscreen de Franjas RGB
      glitchOverlay.classList.remove('hidden');
      
      const bands = glitchOverlay.querySelectorAll('.glitch-band');
      bands.forEach(band => {
         (band as HTMLElement).style.animation = 'none';
         void (band as HTMLElement).offsetWidth;
         (band as HTMLElement).style.animation = '';
      });

      // 3. Ejecutar el cambio de componente en el punto ciego del ruido (150ms)
      setTimeout(() => {
        allViews.forEach(view => {
          if (view.getAttribute('data-view') === targetView) {
            view.classList.remove('hidden');
            
            const animatedContent = view.querySelector('.camera-focus-view');
            if (animatedContent) {
              animatedContent.classList.remove('camera-focus-view');
              void (animatedContent as HTMLElement).offsetWidth; 
              animatedContent.classList.add('camera-focus-view');
            }
          } else {
            view.classList.add('hidden');
          }
        });
      }, 150); 

      // 4. Limpiar las clases y ocultar el overlay al terminar (400ms)
      setTimeout(() => {
        mainLayout.classList.remove('is-digital-glitching');
        glitchOverlay.classList.add('hidden');
      }, 400);
    }
  });
</script>