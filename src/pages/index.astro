---
import Layout from      '../layouts/Layout.astro';
import ReelNavbar from  '../components/ReelNavbar.astro';
import SobreMi from     '../components/views/SobreMi.astro'; 
import Experiencia from '../components/views/Experiencia.astro';
import Contacto from    '../components/views/Contacto.astro';
import Proyectos from   '../components/views/Proyectos.astro';
---

<Layout title="Wilmer Carrasco | Inicio">
  
  <main class="relative z-20 w-full min-h-screen flex flex-col lg:flex-row pointer-events-none">
     
     <section class="w-full lg:w-[60%] xl:w-[65%] h-screen flex items-center justify-center pointer-events-auto p-4 sm:p-6 md:p-12 relative overflow-hidden">
        
        <!-- EL VISOR DE LA CÁMARA -->
        <div id="camera-visor" class="w-full h-full max-w-4xl relative flex items-center justify-center">  
            
            <div class="visor-view w-full h-full" data-view="sobre-mi">
                <SobreMi />
            </div>

            <div class="visor-view w-full h-full hidden" data-view="experiencia">
                <Experiencia />
            </div>

            <div class="visor-view w-full h-full hidden" data-view="proyectos">
                <Proyectos />
            </div>

            <div class="visor-view w-full h-full hidden" data-view="contacto">
                <Contacto />
            </div>

        </div>

     </section>
     
     <ReelNavbar />
     
  </main>

</Layout>

<style is:global>
  /* ========================================================== */
  /* EFECTO VHS GLITCH (Se activa dinámicamente con JS)       */
  /* ========================================================== */
  
  .is-glitching {
    animation: vhs-jitter 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  }

  /* El destello de estática/ruido superpuesto */
  .is-glitching::after {
    content: "";
    position: absolute;
    inset: 0;
    /* Un flash en negativo que simula pérdida de señal */
    background: repeating-linear-gradient(
      0deg,
      rgba(255, 255, 255, 0.1) 0px,
      rgba(255, 255, 255, 0.1) 1px,
      transparent 1px,
      transparent 2px
    ), white;
    mix-blend-mode: difference;
    pointer-events: none;
    z-index: 50;
    animation: vhs-flash 0.35s ease-out both;
  }

  @keyframes vhs-jitter {
    0%   { transform: translate(0, 0) skewX(0); filter: grayscale(0); }
    20%  { transform: translate(-6px, 3px) skewX(3deg); filter: grayscale(1) contrast(2); }
    40%  { transform: translate(6px, -3px) skewX(-3deg); }
    60%  { transform: translate(-2px, 2px) skewX(1deg); }
    80%  { transform: translate(2px, -2px) skewX(-1deg); }
    100% { transform: translate(0, 0) skewX(0); filter: grayscale(0); }
  }

  @keyframes vhs-flash {
    0%   { opacity: 0; }
    30%  { opacity: 0.85; } /* Pico máximo del glitch */
    100% { opacity: 0; }
  }
</style>

<script>
  // EL RECEPTOR DE SEÑAL Y CONTROLADOR DE GLITCH
  const visor = document.getElementById('camera-visor');

  document.addEventListener('visor-change', (e) => {
    const targetView = (e as CustomEvent).detail; 
    const allViews = document.querySelectorAll('.visor-view');

    if (visor) {
      // 1. Reiniciar y disparar el Glitch
      visor.classList.remove('is-glitching');
      void visor.offsetWidth; // Truco para reiniciar animaciones CSS
      visor.classList.add('is-glitching');

      // 2. Ejecutar el cambio de componente justo en el pico de la estática (120ms)
      setTimeout(() => {
        allViews.forEach(view => {
          if (view.getAttribute('data-view') === targetView) {
            view.classList.remove('hidden');
            
            // Reiniciar la animación de enfoque del nuevo componente
            const animatedContent = view.querySelector('.camera-focus-view');
            if (animatedContent) {
              animatedContent.classList.remove('camera-focus-view');
              void (animatedContent as HTMLElement).offsetWidth; 
              animatedContent.classList.add('camera-focus-view');
            }
          } else {
            view.classList.add('hidden');
          }
        });
      }, 120); 

      // 3. Limpiar la clase del glitch cuando termine (350ms)
      setTimeout(() => {
        visor.classList.remove('is-glitching');
      }, 350);
    }
  });
</script>