---
import Layout from '../layouts/Layout.astro';
import ReelNavbar from '../components/ReelNavbar.astro';
import SobreMi from '../components/views/SobreMi.astro';
---

<Layout title="Wilmer Carrasco | Inicio">
  
  <main class="relative z-20 w-full min-h-screen flex flex-col lg:flex-row pointer-events-none">
     
     <section class="w-full lg:w-[60%] xl:w-[65%] h-screen flex items-center justify-center pointer-events-auto p-6 md:p-12">
        
        <div id="camera-visor" class="w-full max-w-3xl h-[600px] border-2 border-white/10 bg-black/60 backdrop-blur-md shadow-[0_0_50px_rgba(0,0,0,0.8)] relative overflow-hidden flex items-center justify-center">
            
            <SobreMi />

        </div>

     </section>
     
     <ReelNavbar />
     
  </main>

</Layout>