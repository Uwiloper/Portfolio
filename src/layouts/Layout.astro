---
import '../styles/global.css';
import contacto from '../data/contacto.json';

// Firma del preloader: la misma frase que cierra Contacto
const lema = contacto.frase || 'Just tasteful';

// Permite que las páginas que usen este layout le pasen un título personalizado
interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const {
  title = "Wilmer Carrasco | Portafolio",
  description = "Wilmer Carrasco (Uwil), Developer & Designer. Desarrollo de software nativo y plataformas web modernas, con diseño gráfico y branding visual.",
  image = "/images/proyectos/lazaro-portada.jpg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Wilmer Carrasco" />
    <meta name="theme-color" content="#121010" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    <!-- Open Graph / redes sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content="Uwil" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- Escala del escenario en escritorio: el diseño de referencia mide 1440×810 y todo el sitio
         (visor, carrete y HUD) se agranda o achica para ocupar la misma proporción en cualquier
         pantalla. Va en línea en el head para que se aplique antes del primer dibujado. -->
    <script is:inline>
      (function () {
        var raiz = document.documentElement;
        function calcular() {
          var w = innerWidth, h = innerHeight;
          var e = w >= 1024 ? Math.min(2.4, Math.max(0.8, Math.min(w / 1440, h / 810))) : 1;
          raiz.style.setProperty('--escala', e.toFixed(3));
        }
        calcular();
        addEventListener('resize', calcular);
        // El preloader de encendido solo se ve una vez por sesión: si ya se vio, se oculta antes de dibujar
        try { if (sessionStorage.getItem('uwil-intro-vista')) raiz.classList.add('sin-intro'); } catch (e) { /* sin almacenamiento: se muestra */ }
      })();
    </script>

    <!-- Joyride (títulos): se precarga para que no parpadee la fuente de respaldo -->
    <link rel="preload" href="/fonts/Joyride.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Fuente del HUD: en <link> porque un @import después de Tailwind se descarta -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" />
  </head>
  
  <body class="bg-[#121010] text-slate-100 font-sans min-h-screen overflow-hidden selection:bg-pink-500 selection:text-white">

    <!-- PRELOADER: encendido de VCR (pantalla azul → PLAY → señal con tracking → se estabiliza → corte).
         Va en línea para verse desde el primer cuadro; el sitio carga debajo mientras tanto. -->
    <div id="intro-vcr" data-fase="azul" aria-hidden="true">
      <div class="iv-senal">
        <span class="iv-banda iv-banda-1"></span>
        <span class="iv-banda iv-banda-2"></span>
        <span class="iv-banda iv-banda-3"></span>
      </div>
      <div class="iv-azul"></div>
      <!-- Tarjeta de título: emerge inestable de la estática y queda nítida al estabilizarse -->
      <div class="iv-titulo">
        <span class="iv-marca" data-texto="UWIL">UWIL</span>
        <span class="iv-lema">{lema}</span>
      </div>
      <div class="iv-osd">
        <span class="iv-av">AV-1</span>
        <span class="iv-play">▶ PLAY</span>
        <!-- Auto-tracking: el marcador busca el centro de la regla y se calma a medida que carga -->
        <span class="iv-tracking">
          <span>TRACKING</span>
          <span class="iv-tr-flecha">◀</span>
          <span class="iv-tr-regla"><i class="iv-tr-marca"></i></span>
          <span class="iv-tr-flecha">▶</span>
          <span class="iv-tr-ok">OK</span>
        </span>
        <span class="iv-saltar">SALTAR ▶▶</span>
      </div>
    </div>
    <script is:inline>
      (function () {
        var intro = document.getElementById('intro-vcr');
        var raiz = document.documentElement;
        if (!intro) return;
        if (raiz.classList.contains('sin-intro')) { intro.remove(); return; }

        var inicio = performance.now();
        var SENAL_DESDE = 750;   // ms: termina el azul y entra la señal
        var BUSQUEDA_MIN = 900;  // ms mínimos buscando señal, para que el tracking se alcance a ver
        var ESTABLE = 750;       // ms de tarjeta de título nítida antes del corte
        var MAX = 3200;          // nunca más de 3,2 s en total, aunque la carga se demore
        var terminado = false, enSenal = false, inicioSenal = 0;
        var p = 0;               // sintonía de 0 a 1: mueve el tracking, limpia la imagen y calma el título
        var fase = function (f) { intro.setAttribute('data-fase', f); };

        // Mientras hay estática, UWIL salta entre fuentes como canales cambiando; al estabilizarse
        // se fija en Joyride (la del logo). Solo fuentes del sistema o ya cargadas: nada que descargar.
        var marca = intro.querySelector('.iv-marca');
        var FUENTES = [
          "'Press Start 2P', monospace",
          "Georgia, 'Times New Roman', serif",
          "'Courier New', Courier, monospace",
          "Impact, 'Arial Narrow Bold', 'Arial Black', sans-serif",
          "'Arial Black', 'Helvetica Neue', sans-serif",
          "'Trebuchet MS', 'Segoe UI', sans-serif",
          "'Times New Roman', Times, serif",
          "'Lucida Console', Monaco, monospace",
          "'Brush Script MT', 'Segoe Script', cursive"
        ];
        var relojFuente = 0, ultimaFuente = -1;
        function cambiarFuente() {
          if (!marca || terminado) return;
          var i;
          do { i = Math.floor(Math.random() * FUENTES.length); } while (i === ultimaFuente);
          ultimaFuente = i;
          marca.style.fontFamily = FUENTES[i];
          marca.style.fontStyle = Math.random() < 0.5 ? 'italic' : 'normal';
          // Cuanto más sintonizada la señal, más despacio cambia
          relojFuente = setTimeout(cambiarFuente, 70 + Math.random() * 110 + p * 260);
        }
        function fijarFuente() {
          clearTimeout(relojFuente);
          if (marca) { marca.style.fontFamily = ''; marca.style.fontStyle = ''; }
        }

        // Carga real: fuentes (40 %), página completa (35 %) e imágenes del fondo (25 %)
        var carga = { fuentes: 0, pagina: 0, fondo: 0 };
        var cargaReal = function () { return carga.fuentes * 0.4 + carga.pagina * 0.35 + carga.fondo * 0.25; };
        (document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve()).then(function () { carga.fuentes = 1; });
        if (document.readyState === 'complete') { carga.pagina = carga.fondo = 1; }
        else addEventListener('load', function () { carga.pagina = carga.fondo = 1; }, { once: true });
        // Las imágenes del fondo van después de este script en el HTML: se cuentan al terminar de leerlo
        document.addEventListener('DOMContentLoaded', function () {
          var imgs = [].slice.call(document.querySelectorAll('#layer-1-bg img'));
          if (!imgs.length) { carga.fondo = 1; return; }
          var listas = 0;
          var una = function () { listas++; carga.fondo = Math.max(carga.fondo, listas / imgs.length); };
          imgs.forEach(function (img) {
            if (img.complete) una(); else { img.addEventListener('load', una, { once: true }); img.addEventListener('error', una, { once: true }); }
          });
        });

        // 1) Azul con AV-1 → aparece PLAY  2) Entra la señal y empieza la búsqueda
        setTimeout(function () { if (!terminado) fase('play'); }, 350);
        setTimeout(function () {
          if (terminado) return;
          fase('senal');
          enSenal = true;
          inicioSenal = performance.now();
          cambiarFuente();
        }, SENAL_DESDE);

        // 3) Reloj de la sintonía: avanza con la carga real, pero nunca más rápido que la búsqueda
        //    mínima ni más lento que el máximo; jamás retrocede. El marcador del tracking oscila
        //    buscando el centro con una amplitud que se apaga al acercarse a 1.
        function sintonizar(ahora) {
          if (terminado) return;
          if (enSenal) {
            var porTiempo = Math.min(1, (ahora - inicioSenal) / BUSQUEDA_MIN);
            var objetivo = ahora - inicio >= MAX - ESTABLE ? 1 : Math.min(porTiempo, cargaReal());
            p = Math.max(p, p + (objetivo - p) * 0.12);
            if (objetivo >= 1 && p > 0.985) p = 1;
            var t = ahora / 1000;
            var amplitud = Math.pow(1 - p, 1.3);
            var desvio = amplitud * (Math.sin(t * 7.5) + 0.25 * Math.sin(t * 23));
            intro.style.setProperty('--p', p.toFixed(3));
            intro.style.setProperty('--tr', Math.max(-1, Math.min(1, desvio)).toFixed(3));
            if (p >= 1) { estabilizar(); return; }
          }
          requestAnimationFrame(sintonizar);
        }
        requestAnimationFrame(sintonizar);

        function estabilizar() {
          if (terminado) return;
          fijarFuente();
          intro.style.setProperty('--p', '1');
          intro.style.setProperty('--tr', '0');
          fase('estable');
          setTimeout(terminar, ESTABLE); // lo justo para leer la tarjeta de título nítida
        }
        // 4) Corte: entra el sitio con el glitch de cambio de canal y la vista hace su enfoque
        function terminar() {
          if (terminado) return;
          terminado = true;
          fijarFuente();
          try { sessionStorage.setItem('uwil-intro-vista', '1'); } catch (e) { /* sin almacenamiento */ }
          fase('fin');
          var activa = document.querySelector('.nav-label.active');
          var vista = (activa && activa.getAttribute('data-target')) || 'sobre-mi';
          document.dispatchEvent(new CustomEvent('visor-change', { detail: vista }));
          setTimeout(function () { intro.remove(); }, 450);
          removeEventListener('keydown', saltar);
        }
        function saltar() { if (!terminado) terminar(); }

        intro.addEventListener('pointerdown', saltar);
        addEventListener('keydown', saltar);
      })();
    </script>

    <div id="layer-1-bg" class="fixed inset-0 z-0 overflow-hidden pointer-events-none">
      <img src="/images/proyectos/lazaro-portada.webp" class="bg-project-image" alt="" decoding="async" />
      <img src="/images/proyectos/invlazaro-foto1.webp" class="bg-project-image" alt="" decoding="async" />
      <img src="/images/proyectos/invlazaro-foto2.webp" class="bg-project-image" alt="" decoding="async" />
    </div>

    <div id="layer-2-vhs" class="fixed inset-0 z-10 pointer-events-none wobbley">
      <canvas id="vhs-canvas" class="w-full h-full opacity-30 mix-blend-screen" style="filter: blur(1px);"></canvas>
      <div class="scanlines"></div>
      <div class="crt-vignette"></div>

      <div class="absolute inset-0 flex flex-col justify-between vhs-hud-container mix-blend-difference pointer-events-none z-30">
        <div class="hud-sup flex justify-between items-start font-bold tracking-widest uppercase">
          <div class="rgb-glitch-text flex items-center gap-2">
            <span class="text-red-500">●</span> REC
          </div>
          <div id="vhs-timer" class="rgb-glitch-text">00:00:00</div>
        </div>

        <div class="hud-inf flex justify-between items-end font-bold tracking-widest uppercase">
          <div class="rgb-glitch-text flex items-center gap-3">
            <span>uwil</span>
          </div>
          <div id="vhs-date" class="rgb-glitch-text">MMM. 00 0000</div>
        </div>
      </div>
    </div>

    <slot />

    <script>
      // Inicia el motor VHS de Canvas
      import '../js/vhs.js';

      // Lógica del Reloj y Fecha OSD
      const dateElement = document.getElementById('vhs-date');
      const now = new Date();
      const months = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
      
      if (dateElement) {
        dateElement.textContent = `${months[now.getMonth()]}. ${now.getDate().toString().padStart(2, '0')} ${now.getFullYear()}`;
      }

      const timerElement = document.getElementById('vhs-timer');
      let seconds = 0;
      
      setInterval(() => {
        seconds++;
        const h = Math.floor(seconds / 3600).toString().padStart(2, '0');
        const m = Math.floor((seconds % 3600) / 60).toString().padStart(2, '0');
        const s = (seconds % 60).toString().padStart(2, '0');
        if (timerElement) timerElement.textContent = `${h}:${m}:${s}`;
      }, 1000);
    </script>
  </body>
</html>