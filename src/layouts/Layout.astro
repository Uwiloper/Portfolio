---
import '../styles/global.css';
import VhsControlsModal from '../components/VhsControlsModal.jsx';

// Permite que las páginas que usen este layout le pasen un título personalizado
interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const {
  title = "Wilmer Carrasco | Portafolio",
  description = "Wilmer Carrasco (Uwil), Developer & Designer. Desarrollo de software nativo y plataformas web modernas, con diseño gráfico y branding visual.",
  image = "/images/proyectos/lazaro-portada.jpg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Wilmer Carrasco" />
    <meta name="theme-color" content="#121010" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    <!-- Open Graph / redes sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content="Uwil" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- Fuente del HUD: en <link> porque un @import después de Tailwind se descarta -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" />
  </head>
  
  <body class="bg-[#121010] text-slate-100 font-sans min-h-screen overflow-hidden selection:bg-pink-500 selection:text-white">
    
    <div id="layer-1-bg" class="fixed inset-0 z-0 overflow-hidden pointer-events-none">
      <img src="/images/proyectos/lazaro-portada.jpg" class="bg-project-image" alt="" />
      <img src="/images/proyectos/invlazaro-foto1.jpg" class="bg-project-image" alt="" />
      <img src="/images/proyectos/invlazaro-foto2.jpg" class="bg-project-image" alt="" />
    </div>

    <div id="layer-2-vhs" class="fixed inset-0 z-10 pointer-events-none wobbley">
      <canvas id="vhs-canvas" class="w-full h-full opacity-30 mix-blend-screen" style="filter: blur(1px);"></canvas>
      <div class="scanlines"></div>
      <div class="crt-vignette"></div>

      <div class="absolute inset-0 flex flex-col justify-between p-6 md:p-10 vhs-hud-container mix-blend-difference pointer-events-none z-30">
        <div class="flex justify-between items-start text-sm md:text-xl lg:text-2xl font-bold tracking-widest uppercase">
          <div class="rgb-glitch-text flex items-center gap-2">
            <span class="text-red-500">●</span> REC
          </div>
          <div id="vhs-timer" class="rgb-glitch-text">00:00:00</div>
        </div>

        <div class="flex justify-between items-end text-xs md:text-lg lg:text-xl font-bold tracking-widest uppercase">
          <div class="rgb-glitch-text flex items-center gap-3">
            <span>uwil</span>
          </div>
          <div id="vhs-date" class="rgb-glitch-text">MMM. 00 0000</div>
        </div>
      </div>
    </div>

    <slot />

    <VhsControlsModal client:load />

    <script>
      // Inicia el motor VHS de Canvas
      import '../js/vhs.js';

      // Lógica del Reloj y Fecha OSD
      const dateElement = document.getElementById('vhs-date');
      const now = new Date();
      const months = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
      
      if (dateElement) {
        dateElement.textContent = `${months[now.getMonth()]}. ${now.getDate().toString().padStart(2, '0')} ${now.getFullYear()}`;
      }

      const timerElement = document.getElementById('vhs-timer');
      let seconds = 0;
      
      setInterval(() => {
        seconds++;
        const h = Math.floor(seconds / 3600).toString().padStart(2, '0');
        const m = Math.floor((seconds % 3600) / 60).toString().padStart(2, '0');
        const s = (seconds % 60).toString().padStart(2, '0');
        if (timerElement) timerElement.textContent = `${h}:${m}:${s}`;
      }, 1000);
    </script>
  </body>
</html>